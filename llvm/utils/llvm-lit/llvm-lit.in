#!@Python3_EXECUTABLE@
# -*- coding: utf-8 -*-

import os
import sys

config_map = {}

def map_config(source_dir, site_config):
    global config_map
    source_dir = os.path.abspath(source_dir)
    source_dir = os.path.normcase(source_dir)
    site_config = os.path.normpath(site_config)
    config_map[source_dir] = site_config

# Set up some builtin parameters, so that by default the LLVM test suite
# configuration file knows how to find the object tree.
builtin_parameters = { 'build_mode' : '@BUILD_MODE@' }

@LLVM_LIT_CONFIG_MAP@

builtin_parameters['config_map'] = config_map

# Make sure we can find the lit package.
llvm_source_root = path(r'@LLVM_SOURCE_DIR@')
sys.path.insert(0, os.path.join(llvm_source_root, 'utils', 'lit'))

import lit.util

if lit.util.pythonize_bool('@LLVM_WINDOWS_PREFER_FORWARD_SLASH@'):
    builtin_parameters['use_normalized_slashes'] = True

if __name__=='__main__':
    # The build's launcher (LLVM_LIT_LAUNCHER), unless LIT_LAUNCHER is already
    # set in the environment; setting it to empty turns the launcher off.
    if r'''@LLVM_LIT_LAUNCHER@''':
        os.environ.setdefault('LIT_LAUNCHER', r'''@LLVM_LIT_LAUNCHER@''')
    from lit.main import main
    main(builtin_parameters)
